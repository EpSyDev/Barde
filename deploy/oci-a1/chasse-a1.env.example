# À copier en ~/.oci/chasse-a1.env sur la VM (hors dépôt), puis compléter.
# Les OCID se trouvent dans la console Oracle (voir ta VM actuelle → onglet Réseau).
TENANCY_OCID=ocid1.tenancy.oc1..xxxx
# Compartiment de la VM actuelle (souvent le compartiment racine = TENANCY_OCID)
COMPARTMENT_OCID=ocid1.tenancy.oc1..xxxx
# Sous-réseau de la VM actuelle : on réutilise le même réseau
SUBNET_OCID=ocid1.subnet.oc1.eu-marseille-1.xxxx
# Clé(s) SSH autorisées sur la nouvelle VM : les mêmes que l'actuelle
SSH_PUBKEY_FILE=/home/ubuntu/.ssh/authorized_keys
# Facultatif : prévenir sur Discord quand c'est gagné (webhook du salon labo)
DISCORD_WEBHOOK_URL=
# Facultatif : tailles tentées (ocpus:Go), disque, intervalle en secondes
# CONFIGS="4:24 2:12"
# BOOT_GB=100
# INTERVAL=90
