[Unit]
Description=Taverne 3D — hub multijoueur temps réel (WebSocket)
After=network-online.target fripouille.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Barde
ExecStart=/home/ubuntu/Barde/venv/bin/python -m hub.server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
